# ── Runtime (Railway service) ────────────────────────────────────────────
# The web container serves static files only — it needs NO database or
# Snowflake credentials. Railway injects PORT automatically; you normally
# don't need to set anything for the service to run.

# Port the server binds to (Railway sets this dynamically; default 8080)
PORT=8080

# ── Data refresh (GitHub Actions secrets — NOT Railway variables) ────────
# The daily data refresh runs in GitHub Actions (.github/workflows/
# refresh-data.yml) and commits data.js to main, which triggers a Railway
# redeploy. These are configured as GitHub repository secrets, never in
# the container:
#
#   SNOWFLAKE_ACCOUNT          e.g. abc12345.us-east-1
#   SNOWFLAKE_USER             service account username
#   SNOWFLAKE_PASSWORD         (or SNOWFLAKE_PRIVATE_KEY_B64 for key-pair auth)
#   SNOWFLAKE_WAREHOUSE        compute warehouse
#   SNOWFLAKE_ROLE             optional, read-only role recommended
#   SNOWFLAKE_DATABASE         optional, defaults to DAASITY_DB

# ── Refresh trigger (Railway cron service variable) ──────────────────────
# Only the separate "launch-dashboard-refresh-trigger" cron service needs
# this — see RAILWAY.md. It dispatches the GitHub workflow on time, because
# GitHub's own cron queue runs it 1.5-2.75h late. Scope it to Actions:
# read+write on this repo only; it must NOT be able to reach Snowflake.

# Fine-grained GitHub PAT, Actions read+write on thrivecausemetics/Launch-Dashboard
REFRESH_DISPATCH_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxxxxxx
